account_id           = "0123456789abcdef0123456789abcdef"
zone_id              = "0123456789abcdef0123456789abcdef"
zone_name            = "clientdomain.com"
app_hostname         = "app.clientdomain.com"
staging_hostname     = "staging.clientdomain.com"
identity_provider_id = "00000000-0000-0000-0000-000000000000"
staff_email_domain   = "clientdomain.com"
staff_emails         = []

waf_mode               = "log" # switch to "block" after one week (runbook)
