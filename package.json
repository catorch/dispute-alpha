{
  "name": "dispute-alpha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "pnpm --filter @da/web dev",
    "build": "pnpm --filter @da/web build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "lint": "biome check . && node scripts/check-scoped-queries.mjs && node scripts/check-migrations.mjs",
    "format": "biome format --write --javascript-formatter-enabled=true --json-formatter-enabled=true --css-formatter-enabled=true .",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate:local": "bash -c 'wrangler d1 migrations apply DB --local -c apps/app/wrangler.jsonc --persist-to \"$(bash scripts/state-dir.sh)\"'",
    "db:seed:local": "curl -fsS -X POST http://localhost:8787/api/v1/dev/seed",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "dev:setup": "bash scripts/dev-setup.sh",
    "screenshots": "node scripts/screenshots.mjs docs/screenshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "wrangler": "^4.155.0"
  }
}
